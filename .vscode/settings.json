{
  // Build outputs churn large binaries (app.asar) on every `npm run dist`.
  // Watching them locks files on Windows (EBUSY) and slows indexing.
  "files.watcherExclude": {
    "**/release/**": true,
    "**/dist/**": true,
    "**/dist-electron/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/release": true,
    "**/dist": true,
    "**/dist-electron": true,
    "**/node_modules": true
  }
}
