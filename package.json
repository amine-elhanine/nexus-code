{
  "name": "nexus",
  "version": "0.3.6",
  "private": true,
  "description": "Nexus — Autonomous AI desktop agent: coding agent, general assistant and grounded notebook Q&A (Electron + LangChain + LangGraph + DeepAgents).",
  "main": "dist-electron/main.js",
  "type": "module",
  "author": "L7A9 <aminet312003@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/L7A9/nexus-code.git"
  },
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"require('node:fs').copyFileSync('electron/pty-host.cjs','dist-electron/pty-host.cjs')\"",
    "build": "tsc -p tsconfig.json && vite build && npm run build:electron",
    "start": "electron .",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "npm run build:electron && electron test/sandbox-and-agent.test.mjs",
    "test:unit": "npm run build:electron && node test/rate-limit.test.mjs && node test/checkpoint-resume.test.mjs",
    "test:notebook": "npm run build:electron && node test/notebook-text.test.mjs && node test/notebook-parse.test.mjs && node test/notebook-library.test.mjs && node test/notebook-pipeline.test.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.nexus.app",
    "productName": "Nexus",
    "publish": [
      {
        "provider": "github",
        "owner": "L7A9",
        "repo": "nexus"
      }
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "afterPack": "./electron/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "public/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} ${version} Portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@langchain/anthropic": "1.5.8",
    "@langchain/aws": "1.4.4",
    "@langchain/core": "1.2.9",
    "@langchain/deepseek": "1.1.10",
    "@langchain/google-genai": "2.3.0",
    "@langchain/groq": "1.3.1",
    "@langchain/langgraph": "1.4.13",
    "@langchain/mistralai": "1.2.0",
    "@langchain/ollama": "1.3.0",
    "@langchain/openai": "1.5.10",
    "@langchain/openrouter": "0.4.10",
    "@langchain/xai": "1.4.10",
    "@llamaindex/llama-cloud": "^2.16.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "deepagents": "1.13.2",
    "docx-preview": "^0.4.0",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "langchain": "1.5.10",
    "langchain-mcp-adapters": "^0.6.0",
    "lucide-react": "1.34.0",
    "mermaid": "^11.17.2",
    "pdf-parse": "^2.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xlsx": "^0.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "10.0.5",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wait-on": "9.1.0"
  },
  "allowScripts": {
    "@homebridge/node-pty-prebuilt-multiarch@0.14.1": true,
    "electron-winstaller@5.4.0": true
  }
}
