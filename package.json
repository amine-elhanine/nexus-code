{
  "name": "nexus",
  "version": "0.1.0",
  "private": true,
  "description": "Nexus — Autonomous AI Coding Agent for Electron",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc -p tsconfig.json && vite build && tsc -p tsconfig.electron.json",
    "start": "electron .",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "npm run build:electron && electron test/sandbox-and-agent.test.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.nexus.app",
    "productName": "Nexus",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "public/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "@langchain/anthropic": "1.5.8",
    "@langchain/aws": "1.4.4",
    "@langchain/core": "1.2.9",
    "@langchain/deepseek": "1.1.10",
    "@langchain/google-genai": "2.3.0",
    "@langchain/groq": "1.3.1",
    "@langchain/langgraph": "1.4.13",
    "@langchain/mistralai": "1.2.0",
    "@langchain/ollama": "1.3.0",
    "@langchain/openai": "1.5.10",
    "@langchain/openrouter": "0.4.10",
    "@langchain/xai": "1.4.10",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "deepagents": "1.13.2",
    "electron-builder": "^26.15.3",
    "langchain": "1.5.10",
    "langchain-mcp-adapters": "^0.6.0",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "10.0.5",
    "electron": "44.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wait-on": "9.1.0"
  }
}
