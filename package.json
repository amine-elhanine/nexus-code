{
  "name": "nexus",
  "version": "0.5.0",
  "private": true,
  "description": "Nexus — Autonomous AI desktop agent: coding agent, general assistant and grounded notebook Q&A (Electron + self-built agentcore runtime).",
  "main": "dist-electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "author": "L7A9 <aminet312003@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/amine-elhanine/nexus-code.git"
  },
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron . --dev\"",
    "build:electron": "tsc -p tsconfig.electron.json && node -e \"require('node:fs').copyFileSync('electron/pty-host.cjs','dist-electron/pty-host.cjs')\" && node -e \"require('node:fs').copyFileSync('electron/plugin-runner.cjs','dist-electron/plugin-runner.cjs')\" && node -e \"const fs=require('node:fs');['system-skills','system-commands','system-agents','system-rules'].forEach(d=>{try{fs.rmSync('dist-electron/'+d,{recursive:true,force:true})}catch(e){} try{fs.cpSync('electron/'+d,'dist-electron/'+d,{recursive:true,force:true})}catch(e){}})\"",
    "build": "tsc -p tsconfig.json && vite build && npm run build:electron",
    "start": "electron .",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test": "npm run build:electron && electron test/sandbox-and-agent.test.mjs",
    "test:renderer": "node scripts/run-renderer-tests.mjs",
    "test:snapshot": "electron test/renderer-snapshot.test.mjs",
    "test:renderer-security": "electron test/renderer-security.test.mjs",
    "test:permissions": "npm run build:electron && node test/permissions.test.mjs",
    "test:unit": "npm run build:electron && node scripts/run-unit-tests.mjs",
    "test:notebook": "npm run build:electron && node test/notebook-text.test.mjs && node test/notebook-parse.test.mjs && node test/notebook-library.test.mjs && node test/notebook-net-guard.test.mjs && node test/notebook-pipeline.test.mjs && node test/notebook-sanitizers.test.mjs && node test/notebook-generation.test.mjs && node test/notebook-agentic.test.mjs && node test/notebook-evidence.test.mjs && node test/notebook-vectors-sqlite.test.mjs && node test/eval-notebook-cli.test.mjs",
    "dist": "npm run build && electron-builder",
    "dist:dir": "npm run build && electron-builder --dir",
    "cli": "node scripts/agent-cli.mjs",
    "eval:agent": "npm run build:electron && node scripts/eval-agent.mjs",
    "eval:notebook": "npm run build:electron && node scripts/eval-notebook.mjs"
  },
  "build": {
    "appId": "com.nexus.app",
    "productName": "Nexus",
    "publish": [
      {
        "provider": "github",
        "owner": "amine-elhanine",
        "repo": "nexus"
      }
    ],
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "afterPack": "./electron/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "node_modules/@homebridge/node-pty-prebuilt-multiarch/**",
      "node_modules/web-tree-sitter/**",
      "node_modules/tree-sitter-wasms/**"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "public/**/*"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nexus",
      "artifactName": "${productName}.Setup.${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}.${version}.Portable.${ext}"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Development"
    }
  },
  "dependencies": {
    "@aiden0z/pptx-renderer": "^1.2.4",
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "@llamaindex/llama-cloud": "^2.16.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "docx": "^9.7.1",
    "docx-preview": "^0.4.0",
    "electron-updater": "^6.8.9",
    "jszip": "^3.10.2",
    "katex": "^0.18.7",
    "lucide-react": "1.34.0",
    "mermaid": "^11.17.2",
    "monaco-editor": "^0.52.2",
    "pdf-parse": "^2.4.5",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tree-sitter-wasms": "0.1.11",
    "web-tree-sitter": "^0.22.4",
    "xlsx": "^0.18.5",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "concurrently": "10.0.5",
    "electron": "44.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "7.0.2",
    "typescript-language-server": "^6.0.1",
    "typescript5": "npm:typescript@^5.9.3",
    "vite": "8.2.2",
    "wait-on": "9.1.0"
  },
  "allowScripts": {
    "@homebridge/node-pty-prebuilt-multiarch@0.14.1": true,
    "electron-winstaller@5.4.0": true
  },
  "bin": {
    "nexus-agent": "scripts/agent-cli.mjs"
  }
}
